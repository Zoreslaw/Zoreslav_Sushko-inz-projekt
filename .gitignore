# ============================================
data/
datasets/
*.csv
*.tsv
*.parquet
*.feather

# Re-allow source code packages after broad data/ and models/ rules
# (gitignore last-match-wins, so these MUST come after the blocking rules)
!server/network/data/
!server/network/data/**
!server/network/models/
!server/network/models/**
!server/TeamUp.Api/Data/
!server/TeamUp.Api/Data/**
!server/TeamUp.Api/Models/
!server/TeamUp.Api/Models/**

# ============================================
# Documentation Builds
# ============================================
docs/_build/
site/
_site/

# ============================================
# Misc
# ============================================
.vscode-test/
.history/
*.cache
.eslintcache
.stylelintcache

# ============================================
# Keep templates and examples
# ============================================
!*.example
!*.template
!*.sample
!.gitkeep
